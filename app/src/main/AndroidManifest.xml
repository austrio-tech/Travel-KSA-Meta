<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.travelaks">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.TravelAks">

        <!-- Splash -->
        <activity
            android:name=".Splash"
            android:exported="true"
            android:windowSoftInputMode="stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth screens — adjustPan pans the screen so the focused field is always visible -->
        <activity android:name=".HomeActivity"      android:exported="false" android:windowSoftInputMode="stateHidden|adjustPan" />
        <activity android:name=".LoginActivity"     android:exported="false" android:windowSoftInputMode="stateHidden|adjustPan" />
        <activity android:name=".SignUpActivity"    android:exported="false" android:windowSoftInputMode="stateHidden|adjustPan" />
        <activity android:name=".Forgetpass"        android:exported="false" android:windowSoftInputMode="stateHidden|adjustPan" />
        <activity android:name=".AdminLoginActivity" android:exported="false" android:windowSoftInputMode="stateHidden|adjustPan" />

        <!-- Main app screens -->
        <activity android:name=".Cites"             android:exported="false" android:windowSoftInputMode="stateHidden" />
        <activity android:name=".HelpDeskActivity"  android:exported="false" android:windowSoftInputMode="stateHidden" />

        <!-- City details -->
        <activity android:name=".RiyadhDetailsActivity"  android:exported="false" android:windowSoftInputMode="stateHidden" />
        <activity android:name=".JeddahDetailsActivity"  android:exported="false" android:windowSoftInputMode="stateHidden" />
        <activity android:name=".MakkahDetailsActivity"  android:exported="false" android:windowSoftInputMode="stateHidden" />
        <activity android:name=".MadinahDetailsActivity" android:exported="false" android:windowSoftInputMode="stateHidden" />

        <!-- Content screens -->
        <activity android:name=".activity_hotel_riyadh"       android:exported="false" android:windowSoftInputMode="stateHidden" />
        <activity android:name=".Tourist_Attractions_Riyadh"  android:exported="false" android:windowSoftInputMode="stateHidden" />
        <activity android:name=".activity_activitiess_riyadh" android:exported="false" android:windowSoftInputMode="stateHidden" />

        <!-- AI Chat — adjustResize shrinks the RecyclerView so the input stays above the keyboard -->
        <activity android:name=".AiChatActivity" android:exported="false" android:windowSoftInputMode="stateHidden|adjustResize" />

        <!-- Admin Panel — adjustPan for all form-heavy screens -->
        <activity android:name=".AdminDashboardActivity"        android:exported="false" android:theme="@style/Theme.TravelAks.Admin" android:windowSoftInputMode="stateHidden" />
        <activity android:name=".AdminManageUsersActivity"      android:exported="false" android:theme="@style/Theme.TravelAks.Admin" android:windowSoftInputMode="stateHidden|adjustPan" />
        <activity android:name=".AdminManageCitiesActivity"     android:exported="false" android:theme="@style/Theme.TravelAks.Admin" android:windowSoftInputMode="stateHidden|adjustPan" />
        <activity android:name=".AdminManageHotelsActivity"     android:exported="false" android:theme="@style/Theme.TravelAks.Admin" android:windowSoftInputMode="stateHidden|adjustPan" />
        <activity android:name=".AdminManageAttractionsActivity" android:exported="false" android:theme="@style/Theme.TravelAks.Admin" android:windowSoftInputMode="stateHidden|adjustPan" />
        <activity android:name=".AdminManageActivitiesActivity" android:exported="false" android:theme="@style/Theme.TravelAks.Admin" android:windowSoftInputMode="stateHidden|adjustPan" />
        <activity android:name=".AdminManageFaqsActivity"       android:exported="false" android:theme="@style/Theme.TravelAks.Admin" android:windowSoftInputMode="stateHidden|adjustPan" />

    </application>

</manifest>
