<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/profile">

    <!-- Logo + App name — top center -->
    <LinearLayout
        android:id="@+id/layout_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="60dp">

        <ImageView
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/logo"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Travel KSA"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="2dp"
            android:shadowColor="#66000000"
            android:shadowRadius="6"
            android:shadowDx="0"
            android:shadowDy="2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Explore Saudi Arabia"
            android:textSize="14sp"
            android:textColor="#DDFFFFFF"
            android:layout_marginTop="4dp"
            android:shadowColor="#AA000000"
            android:shadowRadius="5"
            android:shadowDx="0"
            android:shadowDy="1" />
    </LinearLayout>

    <!-- Buttons — centered in remaining space -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_centerInParent="true"
        android:layout_below="@id/layout_logo"
        android:layout_marginTop="36dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <Button
                android:id="@+id/btn_login"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Login"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_primary"
                android:layout_marginEnd="8dp"
                android:elevation="4dp" />

            <Button
                android:id="@+id/btn_signup"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Sign Up"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_primary"
                android:layout_marginStart="8dp"
                android:elevation="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_helpdesk"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="FAQ"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_secondary"
                android:layout_marginEnd="8dp"
                android:elevation="4dp" />

            <Button
                android:id="@+id/btn_admin"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Admin"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_secondary"
                android:layout_marginStart="8dp"
                android:elevation="4dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="© 2026 Travel KSA"
        android:textColor="#AAFFFFFF"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp"
        android:textSize="13sp"
        android:shadowColor="#AA000000"
        android:shadowRadius="4"
        android:shadowDx="0"
        android:shadowDy="1" />
</RelativeLayout>
