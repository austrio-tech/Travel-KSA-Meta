<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/profile">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#666666"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- العنوان في الوسط أو اليسار -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hotels in Riyadh"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true" />

            <!-- اللوجو أكبر على الجانب الأيمن -->


        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- زر Back -->
    <Button
        android:id="@+id/btn_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⬅️"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#666666"
        android:layout_margin="12dp"
        android:padding="10dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. Bab Samhan Diriyah -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- الصورة الكبيرة -->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bab_samhan"
                        android:contentDescription="Bab Samhan Diriyah" />

                    <!-- المعلومات -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bab Samhan Diriyah"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📞 +966 11 820 8888"
                        android:textSize="17sp"
                        android:textColor="#1E40AF"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4.7 ★ Luxury Heritage Hotel"
                        android:textSize="18sp"
                        android:textColor="#10B981"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="A luxury hotel within the Luxury Collection, located in historic Diriyah, combining heritage and modernity."
                        android:textSize="16sp"
                        android:textColor="#374151"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="6dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 2. The St. Regis Riyadh -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="222dp"
                        android:contentDescription="The St. Regis Riyadh"
                        android:scaleType="centerCrop"
                        android:src="@drawable/stregis" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="The St. Regis Riyadh"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📞 +966 11 820 0000"
                        android:textSize="17sp"
                        android:textColor="#1E40AF"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4.6 ★ Luxury with Butler Service"
                        android:textSize="18sp"
                        android:textColor="#10B981"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="A modern hotel in the Riyadh Via area, featuring personal butler service and international restaurants."
                        android:textSize="16sp"
                        android:textColor="#374151"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="6dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3. The Ritz-Carlton Riyadh -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ritz_carlton"
                        android:contentDescription="The Ritz-Carlton Riyadh" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="The Ritz-Carlton Riyadh"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📞 +966 11 802 8020"
                        android:textSize="17sp"
                        android:textColor="#1E40AF"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4.6 ★ Palace Luxury"
                        android:textSize="18sp"
                        android:textColor="#10B981"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="A luxurious palace amidst gardens on 52 acres, featuring fine dining, a spa, and an indoor pool."
                        android:textSize="16sp"
                        android:textColor="#374151"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="6dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 4. Four Seasons Hotel Riyadh -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/four_seasons"
                        android:contentDescription="Four Seasons Hotel Riyadh" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Four Seasons Hotel Riyadh"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📞 +966 11 211 5000"
                        android:textSize="17sp"
                        android:textColor="#1E40AF"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4.6 ★ Luxury in Kingdom Tower"
                        android:textSize="18sp"
                        android:textColor="#10B981"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Located in Kingdom Tower, featuring a women-only floor, luxury spa, and outdoor pool."
                        android:textSize="16sp"
                        android:textColor="#374151"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="6dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 5. Mandarin Oriental Al Faisaliah Riyadh -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/mandarin"
                        android:contentDescription="Mandarin Oriental" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mandarin Oriental Al Faisaliah Riyadh"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📞 +966 11 273 2000"
                        android:textSize="17sp"
                        android:textColor="#1E40AF"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4.5 ★ Elegant Tower Hotel"
                        android:textSize="18sp"
                        android:textColor="#10B981"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="An elegant hotel in Al Faisaliah Tower featuring double spa, 3 restaurants, and airport shuttle service."
                        android:textSize="16sp"
                        android:textColor="#374151"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="6dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 6. Hyatt Regency Riyadh Olaya -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/hyatt_regency"
                        android:contentDescription="Hyatt Regency Riyadh" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hyatt Regency Riyadh Olaya"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📞 +966 11 288 1234"
                        android:textSize="17sp"
                        android:textColor="#1E40AF"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4.4 ★ Business Luxury Hotel"
                        android:textSize="18sp"
                        android:textColor="#10B981"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="A luxury business hotel in a modern tower with spacious rooms and floor-to-ceiling windows."
                        android:textSize="16sp"
                        android:textColor="#374151"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="6dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>